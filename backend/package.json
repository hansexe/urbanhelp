{
  "name": "urbanhelp-backend",
  "version": "1.0.0",
  "description": "Urban Help - Backend API for Local Services Marketplace",
  "author": "Urban Help Team",
  "private": true,
  "license": "MIT",
  "scripts": {
    "prebuild": "rm -rf dist 2>/dev/null || true",
    "build": "nest build",

    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",

    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",

    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",

    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",

    "db:migrate": "typeorm migration:run -d dist/database.js",
    "db:migrate:undo": "typeorm migration:revert -d dist/database.js",
    "db:migrate:create": "typeorm migration:create",
    "db:migrate:generate": "typeorm migration:generate -d dist/database.js",
    "db:migrate:show": "typeorm migration:show -d dist/database.js",
    "db:schema:log": "typeorm schema:log -d dist/database.js",
    "db:drop": "typeorm schema:drop -d dist/database.js",
    "db:seed": "ts-node src/database/seeds/seed.ts"
  },
  "dependencies": {
    "@nestjs-modules/ioredis": "2.1.0",
    "@nestjs/bull": "10.0.1",
    "@nestjs/common": "10.2.8",
    "@nestjs/config": "3.0.1",
    "@nestjs/core": "10.2.8",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/passport": "10.0.1",
    "@nestjs/platform-express": "10.2.8",
    "@nestjs/schedule": "4.0.1",
    "@nestjs/swagger": "^8.0.0",
    "@nestjs/typeorm": "10.0.0",
    "@sendgrid/mail": "7.7.0",
    "aws-sdk": "2.1450.0",
    "axios": "1.6.2",
    "bcrypt": "^5.1.0",
    "bcryptjs": "2.4.3",
    "bull": "4.11.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.0",
    "dotenv": "16.3.1",
    "jsonwebtoken": "^8.5.1",
    "passport": "0.6.0",
    "passport-jwt": "4.0.1",
    "pg": "8.10.0",
    "redis": "4.6.7",
    "sharp": "0.32.6",
    "stripe": "13.7.0",
    "swagger-ui-express": "^5.0.1",
    "twilio": "3.83.2",
    "typeorm": "0.3.16",
    "uuid": "9.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.2.0",
    "@nestjs/schematics": "^10.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/bull": "^3.15.0",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/sharp": "^0.32.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.49.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.0",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
