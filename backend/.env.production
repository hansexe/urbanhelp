# ===========================
# Application
# ===========================
NODE_ENV=production
PORT=3001

# ===========================
# Database
# ===========================
DB_HOST=YOUR_PRODUCTION_DB_HOST
DB_PORT=5432
DB_NAME=urbanhelp
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_LOGGING=false

# ===========================
# JWT
# ===========================
JWT_SECRET=VERY_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# ===========================
# Redis
# ===========================
REDIS_HOST=YOUR_REDIS_HOST
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD

# ===========================
# Stripe
# ===========================
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_live_xxxxxxxxxx

# ===========================
# SendGrid
# ===========================
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@urbanhelp.com.au

# ===========================
# Twilio
# ===========================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+61xxxxxxxx

# ===========================
# AWS
# ===========================
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=xxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxx
AWS_S3_BUCKET=urbanhelp-production

# ===========================
# Frontend
# ===========================
FRONTEND_URL=https://urbanhelp.com.au