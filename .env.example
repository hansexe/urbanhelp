# ============================================================
# ENVIRONMENT CONFIGURATION
# ============================================================

# Node environment
NODE_ENV=development

# ============================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================================

DB_HOST=localhost
DB_PORT=5432
DB_USER=urbanhelp_user
DB_PASSWORD=urbanhelp_password_change_me
DB_NAME=urbanhelp_dev

# Database SSL (for production)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# ============================================================
# REDIS CONFIGURATION
# ============================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================
# BACKEND SERVER CONFIGURATION
# ============================================================

BACKEND_PORT=3001
BACKEND_HOST=0.0.0.0
LOG_LEVEL=debug

# ============================================================
# FRONTEND SERVER CONFIGURATION
# ============================================================

FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ============================================================
# JWT AUTHENTICATION
# ============================================================

JWT_SECRET=your_jwt_secret_key_change_me_in_production
JWT_EXPIRY=24h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_me
JWT_REFRESH_EXPIRY=7d

# ============================================================
# STRIPE PAYMENT INTEGRATION
# ============================================================

STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_test_your_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key

# Platform commission percentage (0-100)
STRIPE_COMMISSION_PERCENTAGE=10

# ============================================================
# TWILIO SMS INTEGRATION
# ============================================================

TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================================
# SENDGRID EMAIL INTEGRATION
# ============================================================

SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@urbanhelp.com.au
SENDGRID_FROM_NAME=Urban Help

# Email templates
SENDGRID_WELCOME_TEMPLATE_ID=d-template_id_welcome
SENDGRID_OTP_TEMPLATE_ID=d-template_id_otp
SENDGRID_PASSWORD_RESET_TEMPLATE_ID=d-template_id_password_reset
SENDGRID_BOOKING_CONFIRMATION_TEMPLATE_ID=d-template_id_booking_confirmation
SENDGRID_PAYMENT_RECEIPT_TEMPLATE_ID=d-template_id_payment_receipt

# ============================================================
# AWS S3 CONFIGURATION
# ============================================================

AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=urbanhelp-images
AWS_S3_CDN_URL=https://d123456.cloudfront.net

# ============================================================
# GOOGLE PLACES API
# ============================================================

GOOGLE_PLACES_API_KEY=your_google_places_api_key
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=your_google_places_api_key

# ============================================================
# SECURITY CONFIGURATION
# ============================================================

# CORS
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================
# EMAIL VERIFICATION AND PASSWORD RESET
# ============================================================

OTP_EXPIRY_MINUTES=10
PASSWORD_RESET_EXPIRY_MINUTES=15
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30

# ============================================================
# BOOKING CONFIGURATION
# ============================================================

# Default booking lead time (hours)
MIN_BOOKING_LEAD_TIME_HOURS=2
# Maximum booking advance time (days)
MAX_BOOKING_ADVANCE_DAYS=90
# Cancellation refund percentages (by hours before)
REFUND_FULL_HOURS=24
REFUND_PARTIAL_HOURS=1
REFUND_PARTIAL_PERCENTAGE=50

# ============================================================
# NOTIFICATION CONFIGURATION
# ============================================================

# Email notifications
SEND_EMAIL_NOTIFICATIONS=true
EMAIL_BATCH_SIZE=100
EMAIL_BATCH_INTERVAL_SECONDS=60

# SMS notifications
SEND_SMS_NOTIFICATIONS=true
SMS_BATCH_SIZE=50
SMS_BATCH_INTERVAL_SECONDS=30

# ============================================================
# WEBHOOK CONFIGURATION
# ============================================================

# Stripe
STRIPE_WEBHOOK_ENDPOINT=/webhooks/stripe

# ============================================================
# MONITORING AND LOGGING
# ============================================================

# CloudWatch
CLOUDWATCH_NAMESPACE=UrbanHelp
CLOUDWATCH_REGION=ap-southeast-2

# Sentry error tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ============================================================
# FEATURE FLAGS
# ============================================================

FEATURE_STRIPE_PAYMENTS=true
FEATURE_EMAIL_VERIFICATION=true
FEATURE_SMS_NOTIFICATIONS=true
FEATURE_BUSINESS_DASHBOARD=true
FEATURE_CUSTOMER_DASHBOARD=true

# ============================================================
# ADMIN CONFIGURATION
# ============================================================

# Admin email for alerts
ADMIN_EMAIL=admin@urbanhelp.com.au

# ============================================================
# DEPLOYMENT CONFIGURATION (Production)
# ============================================================

# API documentation
API_DOCS_ENABLED=true
SWAGGER_ENABLED=true

# Database migrations
RUN_DB_MIGRATIONS_ON_START=true

# ============================================================
# TESTING CONFIGURATION
# ============================================================

TEST_DB_HOST=localhost
TEST_DB_PORT=5433
TEST_DB_USER=urbanhelp_test
TEST_DB_PASSWORD=test_password
TEST_DB_NAME=urbanhelp_test

# ============================================================
# DEVELOPMENT CONFIGURATION
# ============================================================

# Hot reload
ENABLE_HOT_RELOAD=true

# Debug mode
DEBUG=false
DEBUG_NAMESPACE=urbanhelp:*

# Mock services (for testing without real APIs)
MOCK_STRIPE=false
MOCK_TWILIO=false
MOCK_SENDGRID=false
MOCK_AWS_S3=false

# ============================================================
# SECURITY KEYS (CHANGE THESE IN PRODUCTION!)
# ============================================================

# Encryption key for sensitive data
ENCRYPTION_KEY=your_encryption_key_32_bytes_long_key_here_change_me

# API key for internal services
INTERNAL_API_KEY=your_internal_api_key_change_me

# ============================================================
# REFERENCES
# ============================================================

# Stripe docs: https://stripe.com/docs
# Twilio docs: https://www.twilio.com/docs
# SendGrid docs: https://docs.sendgrid.com/
# AWS S3 docs: https://docs.aws.amazon.com/s3/
# Google Places API: https://developers.google.com/maps/documentation/places
